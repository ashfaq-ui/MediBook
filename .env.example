# =========================================================================
# MediBook Self-Hosting Environment Variables Template
# Copy this file to '.env' and modify the values for your setup.
# =========================================================================

# --- DATABASE CONFIGURATION ---
DB_PORT=5432
DB_NAME=medibook
DB_USER=postgres
DB_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE

# --- BACKEND SERVICE CONFIGURATION ---
BACKEND_PORT=8080
# Secret key for signing JWT tokens. Must be a secure random string (at least 32 characters/256 bits)
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_HERE
JWT_EXPIRATION=86400000

# --- FRONTEND SERVICE CONFIGURATION ---
FRONTEND_PORT=3000
# By default, Nginx acts as a reverse proxy for /api. Leave this as '/api'
# for Unified Origin hosting (works automatically without knowing server IP/domain).
VITE_API_BASE_URL=/api

# --- GOOGLE GEMINI API CONFIGURATION ---
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# --- EMAIL NOTIFICATIONS CONFIGURATION (GMAIL SMTP) ---
# Your Gmail account used to send automated notifications
MAIL_USERNAME=your-gmail-address@gmail.com
# Google Account -> Security -> 2-Step Verification -> App Passwords
MAIL_PASSWORD=your-16-character-gmail-app-password

# --- WSO2 ASGARDEO CONFIGURATION ---
# Issuer URI for spring boot backend resource server
ASGARDEO_ISSUER_URI=https://api.asgardeo.io/t/your_org/oauth2/token
# SPA client configuration
VITE_ASGARDEO_CLIENT_ID=YOUR_ASGARDEO_CLIENT_ID
VITE_ASGARDEO_BASE_URL=https://api.asgardeo.io/t/your_organization
VITE_ASGARDEO_REDIRECT_URL=http://localhost:5173
