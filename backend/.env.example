DATABASE_URL=jdbc:postgresql://localhost:5433/medibook
DB_USERNAME=postgres
DB_PASSWORD=medibookpassword
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
CLINIC_TIMEZONE=Asia/Colombo
COOKIE_SECURE=false

# Optional: create the first administrator only when no ADMIN account exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional SMTP. Disabled until configured; no emails are queued by default.
MAIL_ENABLED=false
MAIL_FROM=noreply@your-clinic.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Optional local Ollama model. Empty model disables AI; clinic help still works.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
